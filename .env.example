# Upstream CLI / server limits
CNKI_BIN=/usr/local/bin/cnki
CNKI_TIMEOUT_SECONDS=90
CNKI_MAX_RESULTS=100
CNKI_MAX_CONCURRENCY=2
HOST=0.0.0.0
PORT=8000

# Development defaults. For production, replace these with your real HTTPS host.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*

# Public listing / policy pages
# Example: https://cnki-scholar.example.com
PUBLIC_BASE_URL=
PUBLISHER_NAME=CNKI Scholar contributors
SUPPORT_EMAIL=

# Copy the exact token shown by the OpenAI plugin submission portal when domain verification is requested.
OPENAI_APPS_CHALLENGE=
